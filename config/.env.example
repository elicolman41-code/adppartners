# ADP Brooklyn Prospecting System — API Keys
# Copy this file to .env and fill in your keys

# Google Maps Places API
# Get at: https://console.cloud.google.com → APIs & Services → Enable "Places API"
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Yelp Fusion API
# Get at: https://www.yelp.com/developers/v3/manage_app
YELP_API_KEY=your_yelp_api_key_here

# Optional: Your name for email personalization
YOUR_NAME=
YOUR_EMAIL=
YOUR_PHONE=
YOUR_LINKEDIN=
